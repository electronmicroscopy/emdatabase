{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/em-dataset.collection.schema.json",
  "title": "EM Dataset Collection",
  "type": "object",
  "patternProperties": {
    "^.+$": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "file": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "checksum": {
          "type": "string",
          "pattern": "^md5:[A-Fa-f0-9]{32}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "detector_manufacturer": {
          "type": "string"
        },
        "detector": {
          "type": "string"
        },
        "microscope_vendor": {
          "type": "string"
        },
        "microscope_model": {
          "type": "string"
        },
        "camera_length": {
          "type": "string"
        },
        "voltage": {
          "type": "string",
          "pattern": "^[0-9]+\\s?kV$"
        },
        "license": {
          "type": "string"
        },
        "technique": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "authors": {
          "type": "object",
          "patternProperties": {
            "^.+$": {
              "type": "object",
              "properties": {
                "affiliation": {
                  "type": "string"
                },
                "orcid": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{4}$"
                }
              },
              "required": [
                "affiliation"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "kind": {
          "type": "string",
          "enum": [
            "dataset",
            "weights"
          ],
          "default": "dataset"
        },
        "model": {
          "type": "object",
          "properties": {
            "class": {
              "type": "string"
            },
            "framework": {
              "type": "string"
            },
            "quantem": {
              "type": "string"
            }
          },
          "required": [
            "class",
            "framework"
          ],
          "additionalProperties": false
        },
        "latest": {
          "$ref": "#/$defs/weightsFile"
        },
        "versions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^\\d{6}$"
          },
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "#/$defs/weightsFile"
              },
              {
                "required": [
                  "url",
                  "checksum",
                  "size_bytes"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "description",
        "source",
        "file"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "kind": {
            "const": "weights"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "model",
          "latest",
          "versions"
        ],
        "allOf": [
          {
            "not": {
              "required": [
                "url"
              ]
            }
          },
          {
            "not": {
              "required": [
                "checksum"
              ]
            }
          },
          {
            "not": {
              "required": [
                "size_bytes"
              ]
            }
          }
        ]
      },
      "else": {
        "allOf": [
          {
            "not": {
              "required": [
                "model"
              ]
            }
          },
          {
            "not": {
              "required": [
                "latest"
              ]
            }
          },
          {
            "not": {
              "required": [
                "versions"
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "weightsFile": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "checksum": {
          "type": "string",
          "pattern": "^md5:[A-Fa-f0-9]{32}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "url",
        "checksum"
      ],
      "additionalProperties": false
    }
  }
}